#!/usr/bin/env bash

# Displays the DNS record type and destination of a domain's subdomains

dns_info() {
    local domain="$1"
    local subdomain="$2"
    local result

    result=$(dig "$subdomain.$domain" +noall +answer)

    if [ -z "$result" ]; then
        echo "The subdomain $subdomain has no DNS record"
        return
    fi

    printf '%s\n' "$result" | awk -v subdomain="$subdomain" '
    $3 == "IN" && NF >= 5 {
        print "The subdomain " subdomain " is a " $4 \
        " record and points to " $5
    }'
}

if [ "$#" -eq 1 ]; then
    for subdomain in www lb-01 web-01 web-02; do
        dns_info "$1" "$subdomain"
    done
elif [ "$#" -eq 2 ]; then
    dns_info "$1" "$2"
else
    echo "Usage: $0 DOMAIN [SUBDOMAIN]"
    exit 1
fi
